# PayPal Sandbox REST app credentials (client id/secret) are read from GCP
# Secret Manager — secrets "paypal-client-id"/"paypal-client-secret" in
# GOOGLE_CLOUD_PROJECT below. Create them once:
#   gcloud secrets create paypal-client-id --replication-policy=automatic
#   echo -n "<id>" | gcloud secrets versions add paypal-client-id --data-file=-
#   (same for paypal-client-secret)
# Get the id/secret themselves from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# GOOGLE_CLOUD_PROJECT is required regardless of LLM backend below — it's
# also where PayPalClient reads the two secrets above from. Run
# `gcloud auth application-default login` then
# `gcloud auth application-default set-quota-project <project>` once.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Gemini credentials for the LangGraph agent's LLM — either:
#   AI Studio (default): set GOOGLE_API_KEY, leave GOOGLE_GENAI_USE_VERTEXAI=false
#   Vertex AI Model Garden: set GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
