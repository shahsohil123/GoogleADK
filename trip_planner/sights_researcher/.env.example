# Required for both the LLM (Vertex AI) and Memory Bank/Session Service
# below. Run `gcloud auth application-default login` then
# `gcloud auth application-default set-quota-project <project>` once.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# The two Agent Engine resources Session Service and Memory Bank records
# are namespaced under — shared across every agent in this repo. Create
# both once from trip_planner/ with `make create-session-storage` and
# `make create-memory-bank`, then paste the printed ids here (just the id,
# e.g. "1234567890123456789" — not the full resource path).
SESSION_AGENT_ENGINE_ID=
MEMORY_AGENT_ENGINE_ID=

# Port the A2A service listens on (make start / sights_researcher_agent.a2a_app:app).
PORT=8003

# Optional live-data APIs (travel_apis.py). Each tool degrades gracefully and
# reports itself unavailable if its key is unset — no single one is required.
# All three below are read from GCP Secret Manager in deployed environments
# (config.py: "duffel-api-key", "openweather-api-key", "google-places-api-key"
# — the runtime SA needs roles/secretmanager.secretAccessor on each). The env
# vars here are local-dev overrides only; they're never passed to the
# deployed container.

# Flights: free sandbox at https://app.duffel.com/join -> Developers ->
# Access tokens -> New token (starts with "duffel_test_"). (Duffel also
# offers Stays/Cars, but both need a separate account access request beyond
# a valid token — not wired in here; hotel/car costs are estimated from
# load_web_page research instead.)
DUFFEL_API_KEY=

# Weather: free tier key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Attractions/restaurants: enable "Places API (New)" and create a key at
# https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=

# Currency conversion uses https://open.er-api.com — free, no key needed.
