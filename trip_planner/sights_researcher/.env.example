# Required for both the LLM (Vertex AI) and Memory Bank/Session Service
# below. Run `gcloud auth application-default login` then
# `gcloud auth application-default set-quota-project <project>` once.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# The two Agent Engine resources Session Service and Memory Bank records
# are namespaced under — shared across every agent in this repo. Create
# both once from trip_planner/ with `make create-session-storage` and
# `make create-memory-bank`, then paste the printed ids here (just the id,
# e.g. "1234567890123456789" — not the full resource path).
SESSION_AGENT_ENGINE_ID=
MEMORY_AGENT_ENGINE_ID=

# Port the A2A service listens on (make start / sights_researcher_agent.a2a_app:app).
PORT=8003
