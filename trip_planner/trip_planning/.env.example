# Required for the LLM (Vertex AI) and Session Service below. Run
# `gcloud auth application-default login` then
# `gcloud auth application-default set-quota-project <project>` once.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# The shared Session Service and Memory Bank resources — the same ones
# sights_researcher uses, so traveler preferences learned by either agent
# are visible to both. Create once from trip_planner/ with
# `make create-session-storage` / `make create-memory-bank`, then paste the
# printed ids here (just the id, e.g. "1234567890123456789" — not the full
# resource path).
SESSION_AGENT_ENGINE_ID=
MEMORY_AGENT_ENGINE_ID=

# Port the A2A service listens on (make start / trip_planning_agent.a2a_app:app).
PORT=8004

# Set automatically by deploy_byoc.py on a fresh `create`, and cleared by
# delete_byoc.py — remembers the live Agent Engine resource so redeploys
# update in place instead of creating a duplicate. No need to set by hand.
AGENT_ENGINE_RESOURCE_NAME=
