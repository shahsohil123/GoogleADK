# Vertex AI Agent Runtime Cloud Mode (.env.dev.example)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_ENGINE_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
GENAI_MODEL=gemini-3-flash-preview
AGENT_REGISTRY_LOCATION=global
BYOC_REPO=travel-concierge-agents
BYOC_IMAGE_TAG=v1

LOCAL_MODE=false

# Shared Vertex AI Agent Engine resources (Session Service & Memory Bank):
SESSION_AGENT_ENGINE_ID=your-session-agent-engine-id
MEMORY_AGENT_ENGINE_ID=your-memory-agent-engine-id

# OpenTelemetry Export to Google Cloud Trace
OTEL_TO_CLOUD=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# BigQuery Agent Analytics Plugin -> Looker Agent Analytics Block
BQ_ANALYTICS_ENABLED=true
BQ_ANALYTICS_PROJECT_ID=your-gcp-project-id
BQ_ANALYTICS_DATASET_ID=agent_analytics
BQ_ANALYTICS_TABLE_ID=agent_events
BQ_ANALYTICS_LOCATION=US
